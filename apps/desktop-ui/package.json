{
  "name": "desktop-ui",
  "version": "1.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "tauri": "tauri",
    "native:broker": "cargo build --manifest-path ../../Cargo.toml -p sens-broker",
    "native:dev": "npm run native:broker && tauri dev",
    "native:prepare": "cargo build --manifest-path ../../Cargo.toml --release -p sens-broker -p sens-mcp -p sens-connect && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-native-sidecars.ps1",
    "native:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@tabler/icons-react": "^3.46.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
